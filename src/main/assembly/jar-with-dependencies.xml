<assembly
	xmlns="http://maven.apache.org/ASSEMBLY/2.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.0.0 http://maven.apache.org/xsd/assembly-2.0.0.xsd">
	
	<!--
		This assembly takes care of putting together the ums.jar including 
		all dependencies as it was in v1.25.1.
	-->

	<id>jar-with-dependencies</id>
	<formats>
		<format>jar</format>
	</formats>
	<includeBaseDirectory>false</includeBaseDirectory>

	<containerDescriptorHandlers>
		<containerDescriptorHandler>
			<handlerName>metaInf-services</handlerName>
		</containerDescriptorHandler>
	</containerDescriptorHandlers>

	<dependencySets>
		<dependencySet>
			<outputDirectory>/</outputDirectory>
			<useProjectArtifact>true</useProjectArtifact>
			<unpack>true</unpack>
			<scope>runtime</scope>
			<excludes>
				<exclude>com.ibm.icu:icu4j</exclude>
			</excludes>
		</dependencySet>
		<!-- Use the charset-only ICU artifact produced before this assembly. -->
		<dependencySet>
			<outputDirectory>/</outputDirectory>
			<useProjectArtifact>false</useProjectArtifact>
			<useProjectAttachments>true</useProjectAttachments>
			<useTransitiveDependencies>false</useTransitiveDependencies>
			<unpack>true</unpack>
			<includes>
				<include>${project.groupId}:${project.artifactId}:jar:icu4j-charset-detection</include>
			</includes>
		</dependencySet>
	</dependencySets>

</assembly>
